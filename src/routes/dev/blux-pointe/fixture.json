                      "kind": "media",
                      "image_embed": "<img src=\"https://d3syaxnfm3oj0e.cloudfront.net/ea3c0e4e-aa87-4d1b-adaa-cb250234ec3c/2c05f47c-cfee-4383-8955-5dea66b4df15.png\" alt=\"pointe-placeholder-4.png\">",
